# API key de Composio (https://dashboard.composio.dev → Settings → API Keys)
COMPOSIO_API_KEY=
# Auth config de Google Analytics (dashboard → Auth Configs). Solo para crear conexiones nuevas.
COMPOSIO_AUTH_CONFIG_ID=
# Identificador de tu usuario en Composio (el mismo con el que conectaste GA4)
COMPOSIO_USER_ID=default
PORT=3000
